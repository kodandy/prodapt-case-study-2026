# Copy to .env and fill in. Never commit .env.
# `make up` / `make demo` work with no .env: compose generates throw-away local secrets
# (scripts/demo_secrets.py) and every value below has a local default.
# Only test card numbers and Stripe test keys are used; raw card numbers are never stored.

# --- Postgres / Redis (compose) ---
POSTGRES_DB=payplat
POSTGRES_USER=payplat
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432
REDIS_PORT=56379
# Read by both services when run outside compose
DATABASE_URL=postgresql+psycopg://payplat:change-me-local-only@localhost:55432/payplat
REDIS_URL=redis://localhost:56379/0

# --- Host ports ---
GATEWAY_PORT=8080
GATEWAY_GRPC_PORT=50051
OPS_AI_PORT=8081
WEB_PORT=8082
WEB_TLS_PORT=8443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Gateway secrets (each at least 32 characters) ---
# Alternatively set GATEWAY_SECRETS_DIR to a directory holding one file per field.
GATEWAY_SECRETS_DIR=
GATEWAY_API_KEY_PEPPER=
GATEWAY_CARD_FINGERPRINT_KEY=
GATEWAY_TOTP_ENCRYPTION_KEY=
# PEM of the RS256 key that signs session / ops-ai tokens
GATEWAY_JWT_PRIVATE_KEY_PEM=
# Simulated card network callbacks (X-Network-Token)
GATEWAY_NETWORK_TOKEN=
# Interim ops dispute resolution header (X-Ops-Admin-Token); leave empty to disable
GATEWAY_OPS_ADMIN_TOKEN=

# --- Gateway settings ---
GATEWAY_DB_ROLE=gateway_app
GATEWAY_DEMO_TOP_UP_ENABLED=false
GATEWAY_GRPC_INSECURE=true
GATEWAY_GRPC_TLS_CERT_PATH=
GATEWAY_GRPC_TLS_KEY_PATH=
GATEWAY_PROVIDER_TIMEOUT_SECONDS=
GATEWAY_RATE_LIMIT_ENABLED=
GATEWAY_RATE_LIMIT_MERCHANT_RPS=
GATEWAY_RATE_LIMIT_MERCHANT_BURST=
GATEWAY_RATE_LIMIT_USER_RPS=
GATEWAY_RATE_LIMIT_USER_BURST=
METRICS_PORT=

# --- Acquirer: simulator (default) or stripe ---
PAYMENT_PROVIDER=simulator
# Test mode only: must start with sk_test_ (live keys are refused)
STRIPE_SECRET_KEY=

# --- ops-ai ---
# Alternatively set OPS_AI_SECRETS_DIR to a directory holding one file per field.
OPS_AI_SECRETS_DIR=
# PEM of the gateway's public key, used to verify tokens
OPS_AI_JWT_PUBLIC_KEY_PEM=
# Optional: without it the assistant uses the deterministic template fallback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_FALLBACK_MODEL=gpt-4.1-nano-2025-04-14
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Evaluation ---
EVAL_REPORT_PATH=
